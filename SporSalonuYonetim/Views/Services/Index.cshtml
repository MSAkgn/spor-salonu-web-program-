@model IEnumerable<SporSalonuYonetim.Models.Service>

@{
    ViewData["Title"] = "Hizmetlerimiz";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>🧘 Hizmetlerimiz</h1>
        <a asp-action="Create" class="btn btn-success btn-lg">+ Yeni Hizmet Ekle</a>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="bg-dark text-white">
                    <tr>
                        <th class="py-3 ps-4">Hizmet Adı</th>
                        <th class="py-3">Açıklama</th>
                        <th class="py-3 text-center">Süre (Dk)</th>
                        <th class="py-3 text-end pe-4">Ücret</th>
                        <th class="py-3 text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold align-middle">@item.Ad</td>
                            <td class="align-middle">@item.Aciklama</td>
                            <td class="text-center align-middle">
                                <span class="badge bg-info text-dark">@item.SureDakika dk</span>
                            </td>
                            <td class="text-end pe-4 align-middle fs-5 text-success">
                                ₺@item.Ucret
                            </td>
                            <td class="text-center align-middle">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <h4>Henüz bir hizmet eklenmemiş.</h4>
                    <p>Yukarıdaki butonu kullanarak ilk hizmeti ekleyin.</p>
                </div>
            }
        </div>
    </div>
</div>