@model SporSalonuYonetim.Models.Service

@{
    ViewData["Title"] = "Hizmet Detayı";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h3>Hizmet Detayları</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3 fw-bold">Hizmet Adı</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Ad)</dd>

                <dt class="col-sm-3 fw-bold">Açıklama</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Aciklama)</dd>

                <dt class="col-sm-3 fw-bold">Süre</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.SureDakika) Dakika</dd>

                <dt class="col-sm-3 fw-bold">Ücret</dt>
                <dd class="col-sm-9 text-success fw-bold">₺@Html.DisplayFor(model => model.Ucret)</dd>
            </dl>
        </div>
        <div class="card-footer bg-white">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Düzenle</a>
            }
            
            <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
        </div>
    </div>
</div>