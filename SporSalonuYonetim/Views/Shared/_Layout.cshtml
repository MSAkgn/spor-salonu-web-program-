<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SporSalonuYonetim</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SporSalonuYonetim.styles.css" asp-append-version="true" />
   
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3 py-3">
            <div class="container">
                <a class="navbar-brand fw-bold text-uppercase text-warning" asp-area="" asp-controller="Home" asp-action="Index">
                    💪 GYM PRO
                </a>
               
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
               
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Trainers" asp-action="Index">Antrenörler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Services" asp-action="Index">Hizmetler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
                        </li>
                    </ul>
                   
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="btn btn-outline-warning btn-sm fw-bold" href="#">Giriş Yap</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-white bg-dark pt-5 pb-3 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5 class="text-warning text-uppercase fw-bold">GYM PRO</h5>
                    <p class="small text-white-50">
                        Şehrin en modern ekipmanları ve uzman kadrosuyla hedeflerine ulaşman için buradayız. Sınırlarını zorla, değişimi hisset.
                    </p>
                </div>

                <div class="col-md-4 mb-4">
                    <h5 class="text-white text-uppercase fw-bold">Hızlı Erişim</h5>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none">Ana Sayfa</a></li>
                        <li><a asp-controller="Trainers" asp-action="Index" class="text-white-50 text-decoration-none">Eğitmen Kadrosu</a></li>
                        <li><a asp-controller="Services" asp-action="Index" class="text-white-50 text-decoration-none">Hizmetler & Fiyatlar</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy" class="text-white-50 text-decoration-none">Gizlilik Politikası</a></li>
                    </ul>
                </div>

                <div class="col-md-4 mb-4">
                    <h5 class="text-white text-uppercase fw-bold">İletişim</h5>
                    <ul class="list-unstyled small text-white-50">
                        <li class="mb-2">📍 Sakarya Üniversitesi Kampüsü, Serdivan</li>
                        <li class="mb-2">📞 (0264) 123 45 67</li>
                        <li class="mb-2">✉️ info@gympro.com</li>
                    </ul>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="text-warning fs-5 text-decoration-none">Instagram</a>
                        <a href="#" class="text-warning fs-5 text-decoration-none">Twitter</a>
                    </div>
                </div>
            </div>
           
            <hr class="border-secondary" />
           
            <div class="text-center small text-white-50">
                &copy; 2025 - SporSalonuYonetim - Tüm Hakları Saklıdır.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>