@model IEnumerable<SporSalonuYonetim.Models.Appointment>

@{
    ViewData["Title"] = "Randevularım";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📅 Randevu Listesi</h2>
        <a asp-action="Create" class="btn btn-primary">+ Yeni Randevu Al</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Henüz oluşturulmuş bir randevu yok.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover shadow-sm">
                <thead class="bg-dark text-white">
                    <tr>
                        <th>Tarih & Saat</th>
                        <th>Antrenör</th>
                        <th>Hizmet</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th>Üye (Email)</th>
                        }
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>
                <span class="fw-bold">@item.TarihSaat.ToString("dd MMMM yyyy")</span> <br/>
                <small class="text-muted">@item.TarihSaat.ToString("HH:mm")</small>
            </td>
            <td>@item.Trainer?.AdSoyad</td>
            <td>@item.Service?.Ad</td>
            
            @if (User.IsInRole("Admin"))
            {
                <td>@item.User?.Email</td>
            }

            @* 1. DURUM (BADGE) MANTIĞI *@
            <td>
                @if (item.TarihSaat < DateTime.Now)
                {
                    @if (item.OnaylandiMi)
                    {
                        <span class="badge bg-secondary">Gerçekleşti</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">İptal Edildi</span>
                    }
                }
                else
                {
                    @if (item.OnaylandiMi)
                    {
                        <span class="badge bg-success">Onaylandı</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Beklemede</span>
                    }
                }
            </td>

            @* 2. İŞLEMLER (BUTON) MANTIĞI *@
            <td>
                @if (item.TarihSaat > DateTime.Now)
                {
                    @* Sadece gelecek randevular için Admin Onay butonu *@
                    @if (User.IsInRole("Admin") && !item.OnaylandiMi)
                    {
                        <a asp-action="Approve" asp-route-id="@item.Id" class="btn btn-sm btn-success me-1">✅ Onayla</a>
                    }
                    
                    @* Gelecek olan randevuyu herkes (Üye/Admin) silebilir *@
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">🗑️ İptal</a>
                }
                else
                {
                    @* Tarihi geçmiş randevular için butonları gizle ve yazı göster *@
                    <span class="text-muted small italic">Geçmiş Randevu</span>
                }
            </td>
        </tr>
    }
</tbody>
            </table>
        </div>
    }
</div>