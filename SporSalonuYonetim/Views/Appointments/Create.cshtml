@model SporSalonuYonetim.Models.Appointment

@{
    ViewData["Title"] = "Randevu Al";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">📅 Yeni Randevu Oluştur</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="form-group mb-3">
                        <label class="control-label fw-bold">Antrenör Seçiniz</label>
                        <select asp-for="TrainerId" class="form-control" asp-items="ViewBag.TrainerId"></select>
                    </div>

                    <div class="form-group mb-3">
                        <label class="control-label fw-bold">Hizmet Seçiniz</label>
                        <select asp-for="ServiceId" class="form-control" asp-items="ViewBag.ServiceId"></select>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="TarihSaat" class="control-label fw-bold">Tarih ve Saat</label>
                        <input asp-for="TarihSaat" class="form-control" type="datetime-local" 
                               min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>

                    <div class="d-grid gap-2">
                        <input type="submit" value="Randevuyu Onayla" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}