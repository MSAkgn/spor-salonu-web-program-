@model SporSalonuYonetim.Models.Trainer

@{
    ViewData["Title"] = "Yeni Antrenör Ekle";
}

<h1>Yeni Antrenör Ekle</h1>

<h4>Antrenör Bilgileri</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="AdSoyad" class="control-label">Ad Soyad</label>
                <input asp-for="AdSoyad" class="form-control" placeholder="Örn: Ahmet Yılmaz" />
                <span asp-validation-for="AdSoyad" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="UzmanlikAlani" class="control-label">Uzmanlık Alanı</label>
                <input asp-for="UzmanlikAlani" class="form-control" placeholder="Örn: Fitness, Pilates" />
                <span asp-validation-for="UzmanlikAlani" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CalismaBaslangicSaati" class="control-label">Mesai Başlangıç</label>
                <input asp-for="CalismaBaslangicSaati" class="form-control" type="time" /> 
                <span asp-validation-for="CalismaBaslangicSaati" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CalismaBitisSaati" class="control-label">Mesai Bitiş</label>
                <input asp-for="CalismaBitisSaati" class="form-control" type="time" />
                <span asp-validation-for="CalismaBitisSaati" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Kaydet" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}