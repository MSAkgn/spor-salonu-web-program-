@model SporSalonuYonetim.Models.Trainer

@{
    ViewData["Title"] = "Antrenör Detayı";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h3>Antrenör Bilgileri</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3 fw-bold">Ad Soyad</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.AdSoyad)</dd>

                <dt class="col-sm-3 fw-bold">Uzmanlık Alanı</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.UzmanlikAlani)</dd>

                <dt class="col-sm-3 fw-bold">Çalışma Saatleri</dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.CalismaBaslangicSaati) - @Html.DisplayFor(model => model.CalismaBitisSaati)
                </dd>
            </dl>
        </div>
        <div class="card-footer bg-white">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Düzenle</a>
            }
            
            <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
        </div>
    </div>
</div>