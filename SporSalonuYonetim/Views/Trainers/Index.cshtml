@model IEnumerable<SporSalonuYonetim.Models.Trainer>

@{
    ViewData["Title"] = "Antrenörlerimiz";
}

<style>
    .trainer-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
    }
    .trainer-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }
    .trainer-img-wrapper {
        height: 350px;
        overflow: hidden;
        position: relative;
    }
    .trainer-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s;
        object-position: top center;
    }
    .trainer-card:hover .trainer-img {
        transform: scale(1.1);
    }
    .social-btn {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0 5px;
        color: white;
        text-decoration: none;
        transition: 0.3s;
    }
    .social-btn:hover { opacity: 0.8; color: white; }
    
    .branch-badge {
        position: absolute; 
        top: 15px; 
        right: 15px; 
        background: rgba(255, 87, 34, 0.9); 
        color: white; 
        padding: 5px 15px; 
        border-radius: 20px; 
        font-weight: bold; 
        font-size: 0.8rem;
        backdrop-filter: blur(5px);
    }
</style>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="display-5 fw-bold">Eğitmenlerimiz</h1>
            <p class="text-muted">Hedeflerinize ulaşmanız için uzman kadromuz.</p>
        </div>
        
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-dark btn-lg shadow">+ Yeni Eğitmen</a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <h4>Henüz kayıtlı eğitmen yok.</h4>
            <p>Admin panelinden ekleme yapabilirsiniz.</p>
        </div>
    }

    <div class="row g-4">
        @foreach (var item in Model)
        {
            // --- GÖRSEL MANTIĞI AYNI KALIYOR ---
            string ad = item.AdSoyad.ToLower();
            string brans = item.UzmanlikAlani.ToLower();
            string imgUrl = "";
            string[] kadinIsimleri = { "ayşe", "fatma", "zeynep", "elif", "merve", "gamze", "seda", "kübra", "buse", "hande", "esra", "çiğdem", "ebru", "deniz", "gizem", "hatice", "beyza", "sinem", "irem", "selin", "pelin", "gül", "nur" };
            bool isWoman = kadinIsimleri.Any(x => ad.Contains(x));

            if (brans.Contains("yoga") || brans.Contains("pilates") || brans.Contains("esneklik")) {
                imgUrl = isWoman ? "https://images.unsplash.com/photo-1518611012118-696072aa579a?q=80&w=1470&auto=format&fit=crop" : "https://images.unsplash.com/photo-1552196563-55cd4e45efb3?q=80&w=1374&auto=format&fit=crop";
            } else if (brans.Contains("boks") || brans.Contains("kick") || brans.Contains("muay") || brans.Contains("dövüş")) {
                imgUrl = isWoman ? "https://images.unsplash.com/photo-1591117207239-788bf8de6c3b?q=80&w=1470&auto=format&fit=crop" : "https://images.unsplash.com/photo-1583454110551-21f2fa2afe61?q=80&w=1374&auto=format&fit=crop";
            } else if (brans.Contains("yüzme") || brans.Contains("havuz") || brans.Contains("swim")) {
                imgUrl = isWoman ? "https://images.unsplash.com/photo-1576013551627-0cc20b96c2a7?q=80&w=1470&auto=format&fit=crop" : "https://images.unsplash.com/photo-1530549387789-4c1017266635?q=80&w=1470&auto=format&fit=crop";
            } else if (brans.Contains("crossfit") || brans.Contains("ağır")) {
                imgUrl = isWoman ? "https://images.unsplash.com/photo-1594381898411-846e7d193883?q=80&w=1374&auto=format&fit=crop" : "https://images.unsplash.com/photo-1517963879466-cd88b8d211cc?q=80&w=1470&auto=format&fit=crop";
            } else if (brans.Contains("zumba") || brans.Contains("dans")) {
                imgUrl = "https://images.unsplash.com/photo-1524594152303-9fd13543fe6e?q=80&w=1470&auto=format&fit=crop";
            } else if (brans.Contains("spinning") || brans.Contains("bisiklet")) {
                 imgUrl = "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=1470&auto=format&fit=crop";
            } else {
                imgUrl = isWoman ? "https://images.unsplash.com/photo-1611672585731-fa10603fb9e0?q=80&w=1374&auto=format&fit=crop" : "https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?q=80&w=1470&auto=format&fit=crop";
            }
            // ----------------------------------------

            <div class="col-md-4">
                <div class="trainer-card">
                    <div class="trainer-img-wrapper">
                        <img src="@imgUrl" class="trainer-img" alt="@item.AdSoyad">
                        <div class="branch-badge">@item.UzmanlikAlani</div>
                    </div>

                    <div class="card-body text-center p-4">
                        <h4 class="fw-bold mb-1">@item.AdSoyad</h4>
                        <p class="text-muted small">Profesyonel Eğitmen</p>
                        
                        <div class="d-flex justify-content-center mb-3">
                            <span class="badge bg-light text-dark border me-2">🕒 @item.CalismaBaslangicSaati - @item.CalismaBitisSaati</span>
                        </div>

                        <div class="mb-4">
                            <a href="#" class="social-btn bg-primary"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" class="social-btn" style="background: #E1306C"><i class="fab fa-instagram"></i></a>
                            <a href="#" class="social-btn bg-info"><i class="fab fa-twitter"></i></a>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-controller="Appointments" asp-action="Create" asp-route-trainerId="@item.Id" class="btn btn-outline-dark rounded-pill">Özel Ders Al</a>
                             
                             @if (User.IsInRole("Admin"))
                             {
                                 <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                                 </div>
                             }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>