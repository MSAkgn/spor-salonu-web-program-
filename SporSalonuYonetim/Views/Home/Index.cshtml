@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="hero-section">
    <div class="hero-content container">
        <h1>Sınırlarını Zorla, <span style="color: #ff5722;">Potansiyelini Keşfet</span></h1>
        <p>
            Türkiye'nin ilk Yapay Zeka destekli spor salonu yönetim sistemi. 
            Fotoğrafını yükle, AI koçun sana özel analizini yapsın.
        </p>
        
        <a asp-controller="Ai" asp-action="Index" class="btn-gym">
            🚀 YAPAY ZEKA İLE ANALİZ YAP
        </a>
    </div>
</div>

<div class="container mb-5" style="margin-top: -50px; position: relative; z-index: 2;">
    <div class="row g-4">
        
        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">🤖</div>
                <h3 class="feature-title">AI Vücut Analizi</h3>
                <p class="text-muted">Gemini AI teknolojisi ile boy, kilo ve fotoğraflarınızdan yağ oranı ve sağlık analizi çıkarın.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">📅</div>
                <h3 class="feature-title">Akıllı Program</h3>
                <p class="text-muted">Antrenman günlerinizi planlayın, size özel atanan dersleri kaçırmayın ve gelişiminizi izleyin.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon">📈</div>
                <h3 class="feature-title">Gelişim Raporları</h3>
                <p class="text-muted">Aylık gelişim grafiklerinizi inceleyin, BMI değişimlerinizi kontrol altında tutun.</p>
            </div>
        </div>

    </div>
</div>

<section class="pricing-section py-5">
    <div class="container">
        
        <div class="section-title text-center mb-5">
            <h2 class="fw-bold">Neden <span style="color: #ff5722;">Bizi Seçmelisiniz?</span></h2>
            <p class="text-muted">Sakarya'nın en kapsamlı spor ve teknoloji merkezinde yerinizi ayırtın.</p>
        </div>

        <div class="row g-4">
            
            <div class="col-md-4">
                <div class="pricing-card h-100 shadow-sm border-0">
                    <div class="pricing-header text-center p-4 bg-light">
                        <div class="display-4 mb-2">🏅</div>
                        <h4 class="fw-bold">UZMAN KADRO</h4>
                        <p class="small text-muted mb-0">Profesyonel Eğitmenler</p>
                    </div>
                    <div class="pricing-body p-4">
                        <ul class="pricing-list list-unstyled">
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Sertifikalı Antrenörler</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Birebir Özel Ders (PT)</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Uzmanlık Alanı Seçimi</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Müsaitlik Takvimi</li>
                        </ul>
                        <div class="d-grid mt-4">
                            <a asp-controller="Trainers" asp-action="Index" class="btn btn-dark rounded-pill py-2">Eğitmenleri Tanı</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="pricing-card h-100 shadow border-0 popular" style="transform: scale(1.05);">
                    <div class="pricing-header text-center p-4" style="background: linear-gradient(135deg, #ff5722, #ff8a65); color: white;">
                        <div class="display-4 mb-2">🔥</div>
                        <h4 class="fw-bold text-white">GENİŞ HİZMET</h4>
                        <p class="small text-white-50 mb-0">Çok Yönlü Gelişim</p>
                    </div>
                    <div class="pricing-body p-4 bg-white">
                        <ul class="pricing-list list-unstyled">
                            <li class="mb-2"><i class="fas fa-star text-warning me-2"></i><b>Fitness & Bodybuilding</b></li>
                            <li class="mb-2"><i class="fas fa-star text-warning me-2"></i><b>Yoga & Pilates Grup Dersleri</b></li>
                            <li class="mb-2"><i class="fas fa-star text-warning me-2"></i><b>Kardiyo ve Yağ Yakımı</b></li>
                            <li class="mb-2"><i class="fas fa-star text-warning me-2"></i><b>Modern Ekipman Parkuru</b></li>
                        </ul>
                        <div class="d-grid mt-4">
                            <a asp-controller="Services" asp-action="Index" class="btn btn-primary rounded-pill py-2 shadow border-0" style="background-color: #ff5722;">Hizmetlere Göz At</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="pricing-card h-100 shadow-sm border-0">
                    <div class="pricing-header text-center p-4 bg-light">
                        <div class="display-4 mb-2">🤖</div>
                        <h4 class="fw-bold">AI ANALİZ</h4>
                        <p class="small text-muted mb-0">Teknolojiyle Gelişin</p>
                    </div>
                    <div class="pricing-body p-4">
                        <ul class="pricing-list list-unstyled">
                            <li class="mb-2"><i class="fas fa-brain text-primary me-2"></i>Görsel Vücut Analizi</li>
                            <li class="mb-2"><i class="fas fa-brain text-primary me-2"></i>Boy/Kilo Öneri Motoru</li>
                            <li class="mb-2"><i class="fas fa-brain text-primary me-2"></i>Kişiye Özel Diyet Planı</li>
                            <li class="mb-2"><i class="fas fa-brain text-primary me-2"></i>Egzersiz Simülasyonu</li>
                        </ul>
                        <div class="d-grid mt-4">
                            <a asp-controller="Ai" asp-action="Index" class="btn btn-outline-dark rounded-pill py-2">Analizi Başlat</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<div class="container-fluid py-5" style="background-color: #333; color: white;">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-4">
                <h2 style="color: #ff5722; font-weight: bold;">500+</h2>
                <p>Mutlu Üye</p>
            </div>
            <div class="col-md-4">
                <h2 style="color: #ff5722; font-weight: bold;">12</h2>
                <p>Profesyonel Eğitmen</p>
            </div>
            <div class="col-md-4">
                <h2 style="color: #ff5722; font-weight: bold;">%100</h2>
                <p>Yapay Zeka Doğruluğu</p>
            </div>
        </div>
    </div>
</div>